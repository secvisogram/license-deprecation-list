{
  "name": "@secvisogram/license-deprecation-list",
  "version": "1.0.0",
  "description": "Provide information about when spdx and aboutcode licenses and exceptions are deprecated",
  "keywords": [
    "aboutcode",
    "license",
    "spdx"
  ],
  "homepage": "https://github.com/secvisogram/license-deprecation-list#readme",
  "bugs": {
    "url": "https://github.com/secvisogram/license-deprecation-list/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secvisogram/license-deprecation-list.git"
  },
  "files": [
    "index.js",
    "lib",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "exports": {
    "import": "./index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "test": "oxfmt --check && tsc -b .",
    "update_license_information": "git submodule update --init --remote && node scripts/update_license_information.ts",
    "prepublishOnly": "rm -r dist && tsc -b tsconfig.src.json",
    "prepare": "peggy --format es scripts/licenseParser.peggy"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "oxfmt": "^0.65.0",
    "peggy": "^5.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
